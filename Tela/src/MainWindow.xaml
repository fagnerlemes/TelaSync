<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tela — Gerenciador de monitores" Width="1380" Height="1200" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

 <Grid x:Name="RootView" Background="{DynamicResource AppBackground}">
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left"><Image x:Name="BrandIcon" Width="32" Height="32" Margin="0,0,10,0"/><TextBlock x:Name="BrandTitle" Text="TelaSync" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Text="Versão 0.1.0" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,18,0"/><Button x:Name="ThemeButton" Content="Tema claro" MinHeight="32" Padding="10,5" Margin="0,0,14,0"/>
    <Button x:Name="WindowMinimizeButton" Content="&#xE921;" Style="{StaticResource ChromeButton}" ToolTip="Minimizar" AutomationProperties.Name="Minimizar janela"/>
    <Button x:Name="WindowMaximizeButton" Content="&#xE922;" Style="{StaticResource ChromeButton}" ToolTip="Maximizar ou restaurar" AutomationProperties.Name="Maximizar ou restaurar janela"/>
    <Button x:Name="WindowCloseButton" Content="&#xE8BB;" Style="{StaticResource ChromeButton}" ToolTip="Fechar janela" AutomationProperties.Name="Fechar janela"/></StackPanel></DockPanel>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Sidebar}" Padding="10,22,10,18"><DockPanel><StackPanel DockPanel.Dock="Top"><Button x:Name="TelasNav" Content="Telas" Style="{StaticResource NavButton}"/><Button x:Name="PerfisNav" Content="Perfis" Style="{StaticResource NavButton}"/><Button x:Name="AtalhosNav" Content="Atalhos" Style="{StaticResource NavButton}"/><Button x:Name="SettingsNav" Content="Preferências" Style="{StaticResource NavButton}"/></StackPanel><StackPanel VerticalAlignment="Bottom" Margin="10,0"><TextBlock Text="Seu espaço.&#10;Na mesma ordem." Style="{StaticResource Hint}"/><Button x:Name="DiagnosticsButton" Content="Diagnóstico" Style="{StaticResource NavButton}" Padding="0,10" Margin="0,10,0,0"/></StackPanel></DockPanel></Border>
   <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24,28,20">
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Monitores" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="TvModeButton" Content="Jogar na TV" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="RestoreWorkspaceButton" Content="Voltar à mesa" Margin="0,0,8,0" Visibility="Collapsed"/><Button x:Name="RefreshButton" Content="Atualizar" Margin="0,0,8,0"/><Button x:Name="IdentifyButton" Content="Identificar telas"/></StackPanel></Grid>
    <Grid x:Name="MonitorsPage"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="306"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Border Background="{DynamicResource PanelFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20,16"><StackPanel><Grid Margin="0,0,0,5"><TextBlock x:Name="MapTitle" Text="Disposição das telas" Style="{StaticResource Section}" VerticalAlignment="Center"/><Button x:Name="EditLayoutButton" Content="Organizar telas" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinHeight="32" Padding="10,5"/></Grid>
       <Canvas x:Name="MonitorMap" Height="190" Margin="0,9,0,7" Background="Transparent" ClipToBounds="True"/>
       <StackPanel x:Name="LayoutControls" Visibility="Collapsed" Margin="0,0,0,12">
        <WrapPanel VerticalAlignment="Center"><TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="XPositionInput" Width="84" AutomationProperties.Name="Posição horizontal X"/><TextBlock Text="Y" VerticalAlignment="Center" Margin="14,0,7,0"/><TextBox x:Name="YPositionInput" Width="84" AutomationProperties.Name="Posição vertical Y"/><TextBlock Text="Número" VerticalAlignment="Center" Margin="14,0,7,0"/><TextBox x:Name="NumberInput" Width="50" AutomationProperties.Name="Número da tela"/><Button x:Name="SetPositionButton" Content="Atualizar" Margin="10,0,0,0"/><Button x:Name="MakePrimaryButton" Content="Definir principal" Margin="10,0,0,0"/></WrapPanel>
        <WrapPanel Margin="0,8,0,0"><Button x:Name="RotateLeftButton" Content="↶ 90°" Margin="0,4,8,0" ToolTip="Girar a tela selecionada 90° no sentido anti-horário" AutomationProperties.Name="Girar 90 graus à esquerda"/><Button x:Name="RotateRightButton" Content="↷ 90°" Margin="0,4,16,0" ToolTip="Girar a tela selecionada 90° no sentido horário" AutomationProperties.Name="Girar 90 graus à direita"/><Button x:Name="ApplyLayoutButton" Content="Aplicar disposição" Style="{StaticResource PrimaryButton}" Margin="0,4,8,0"/><Button x:Name="CancelLayoutButton" Content="Cancelar edição" Margin="0,4,0,0"/></WrapPanel>
       </StackPanel>
       <TextBlock x:Name="MapHint" Text="Organize as telas por arraste. A posição fica salva para a próxima ativação." Style="{StaticResource Hint}"/></StackPanel></Border>
      <Grid Margin="0,18,0,9"><TextBlock Text="Suas telas" Style="{StaticResource Section}"/><TextBlock x:Name="DeviceCount" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
      <StackPanel x:Name="DisplayRows"/>
      <Button x:Name="RememberButton" Content="Registrar a disposição atual" HorizontalAlignment="Left" Margin="0,16,0,0"/>
     </StackPanel>
     <Border Grid.Column="2" Background="{DynamicResource PanelFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="21" VerticalAlignment="Top"><StackPanel>
      <TextBlock x:Name="SelectedNumber" Text="Tela selecionada" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
      <TextBlock x:Name="SelectedName" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="SelectedModel" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
      <TextBlock x:Name="SelectedStatus" Margin="0,13,0,0" FontSize="12"/>
      <Grid Margin="0,15,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,8,15"><TextBlock Text="Resolução" Style="{StaticResource Hint}"/><TextBlock x:Name="ResolutionValue" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,0,15"><TextBlock Text="Posição salva" Style="{StaticResource Hint}"/><TextBlock x:Name="PositionValue" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,0,8,0"><TextBlock Text="Orientação" Style="{StaticResource Hint}"/><TextBlock x:Name="OrientationValue" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Desktop agora" Style="{StaticResource Hint}"/><TextBlock x:Name="CurrentPositionValue" Margin="0,3,0,0"/></StackPanel>
      </Grid>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12" Margin="0,0,0,0"><StackPanel>
       <Grid><TextBlock Text="Brilho do monitor" Style="{StaticResource Section}"/><TextBlock x:Name="BrightnessValue" Text="—" HorizontalAlignment="Right" Foreground="{DynamicResource AccentInk}"/></Grid>
       <Grid Margin="0,8,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" AutomationProperties.Name="Brilho do monitor selecionado"/><Button x:Name="ReadBrightnessButton" Grid.Column="1" Content="Ler" Margin="8,0,0,0" MinHeight="30" Padding="9,5"/><Button x:Name="ApplyBrightnessButton" Grid.Column="2" Content="Aplicar" Margin="6,0,0,0" MinHeight="30" Padding="9,5"/></Grid>
       <TextBlock x:Name="BrightnessHint" Style="{StaticResource Hint}" FontSize="12"/>
      </StackPanel></Border>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="0,12"><StackPanel>
       <TextBlock Text="Imagem e energia" Style="{StaticResource Section}" Margin="0,0,0,10"/>
       <Button x:Name="BlackScreenButton" Content="Tela preta" AutomationProperties.Name="Exibir tela preta somente no monitor selecionado"/>
       <TextBlock Text="Simulação visual · iluminação continua ligada." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
       <TextBlock Text="Para voltar: Acender ou Ctrl+Alt+L." Style="{StaticResource Hint}" Margin="0,5,0,12"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="PowerButton" Content="Repouso" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Colocar somente o painel selecionado em repouso"/><Button x:Name="WakeButton" Grid.Column="2" Content="Acender" AutomationProperties.Name="Acender o painel selecionado ou remover a tela preta"/></Grid>
       <TextBlock x:Name="PowerSupportLabel" Style="{StaticResource Hint}" Margin="0,8,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
       <Button x:Name="ProbeButton" Content="Verificar compatibilidade" Margin="0,10,0,0" Padding="8,6" MinHeight="32"/>
      </StackPanel></Border>
      <CheckBox x:Name="PreserveCheck" Content="Preservar posição ao reativar" IsChecked="True" Margin="0,15,0,0"/><TextBlock x:Name="MemoryNote" Style="{StaticResource Hint}" Margin="19,6,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="SetPrimaryDirectButton" Content="Tornar principal" Padding="8,8" AutomationProperties.Name="Definir a tela selecionada como principal"/><Button x:Name="ToggleButton" Grid.Column="2" Content="Desativar tela" Padding="8,8"/></Grid><TextBlock x:Name="ToggleNote" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
     </StackPanel></Border>
    </Grid>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="740" HorizontalAlignment="Left">
     <TextBlock Text="Modo TV" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock Text="Escolha a TV usada pelo botão Jogar na TV. Voltar à mesa recupera as telas ativas, a principal e as posições anteriores." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
     <ComboBox x:Name="TvPicker" MinWidth="400" HorizontalAlignment="Left" AutomationProperties.Name="Tela usada no modo TV"/>
     <TextBlock x:Name="TvModeStatus" Style="{StaticResource Hint}" Margin="0,12,0,28"/>
     <TextBlock Text="Inicialização e bandeja" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24"/>
     <CheckBox x:Name="StartupCheck" Content="Iniciar o TelaSync com o Windows"/>
     <TextBlock Text="Quando ativado, o programa abre na bandeja ao entrar no Windows. Você pode abrir a janela pelo ícone ao lado do relógio." Style="{StaticResource Hint}" Margin="25,10,0,24"/>
     <TextBlock x:Name="StartupStatus" Style="{StaticResource Hint}" Margin="0,0,0,24"/>
     <TextBlock Text="Ao fechar a janela" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="O botão X oferece as opções de minimizar para a bandeja, fechar o programa ou cancelar. No menu da bandeja, use Abrir TelaSync ou Sair." Style="{StaticResource Hint}"/>
    </StackPanel>
    <StackPanel x:Name="ProfilesPage" Visibility="Collapsed"><TextBlock Text="Perfis salvos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><StackPanel x:Name="ProfileRows"/><TextBlock Text="Cada perfil guarda as telas ativas e as posições que serão recuperadas." Style="{StaticResource Hint}" Margin="0,15,0,0"/></StackPanel>
    <StackPanel x:Name="ShortcutsPage" Visibility="Collapsed"><TextBlock Text="Atalhos globais" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Ctrl + Alt + P    Apagar o painel selecionado" Margin="0,0,0,18"/><TextBlock Text="Ctrl + Alt + L    Acender o painel selecionado" Margin="0,0,0,18"/><TextBlock Text="Ctrl + Alt + D    Desativar ou reativar a tela selecionada" Margin="0,0,0,18"/><TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}"/></StackPanel>
    <Border x:Name="ProfileBar" Background="{DynamicResource Sidebar}" CornerRadius="8" Padding="16,13" Margin="0,23,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Perfil de telas" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="ProfilePicker" Grid.Column="1" IsEditable="True" AutomationProperties.Name="Nome do perfil"/><Button x:Name="ApplyProfileButton" Grid.Column="2" Content="Aplicar" Margin="8,0,0,0"/><Button x:Name="SaveProfileButton" Grid.Column="3" Content="Salvar perfil" Margin="8,0,0,0"/></Grid></Border>
    <TextBlock x:Name="Feedback" Style="{StaticResource Hint}" Margin="0,15,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Panel}" Padding="22,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="MemoryStatus" Text="Memória de posição ativada" Style="{StaticResource Hint}" VerticalAlignment="Center"/><Button x:Name="AboutButton" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,0" MinHeight="36" AutomationProperties.Name="Sobre o TelaSync — By Fagner Lemes"><Rectangle x:Name="AuthorSignature" Width="145" Height="35" Fill="{DynamicResource Muted}"/></Button><TextBlock x:Name="OperationStatus" Grid.Column="2" Text="Aguardando uma ação" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Hint}"/></Grid></Border>
 </Grid>
</Window>
