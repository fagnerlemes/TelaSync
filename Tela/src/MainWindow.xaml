<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tela — Gerenciador de monitores" Width="1180" Height="970" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <SolidColorBrush x:Key="AppBackground" Color="#15181C"/><SolidColorBrush x:Key="Panel" Color="#1C2025"/><SolidColorBrush x:Key="Sidebar" Color="#191D22"/>
  <SolidColorBrush x:Key="Ink" Color="#ECF0F4"/><SolidColorBrush x:Key="Muted" Color="#A1ABB8"/><SolidColorBrush x:Key="Line" Color="#323942"/>
  <SolidColorBrush x:Key="Accent" Color="#2878CF"/><SolidColorBrush x:Key="AccentInk" Color="#94C8FF"/><SolidColorBrush x:Key="Soft" Color="#20354B"/><SolidColorBrush x:Key="Screen" Color="#2B3643"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Soft}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="35"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid x:Name="RootView" Background="{DynamicResource AppBackground}">
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left"><Image x:Name="BrandIcon" Width="32" Height="32" Margin="0,0,10,0"/><TextBlock x:Name="BrandTitle" Text="TelaSync" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Text="Versão 0.1.0" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,18,0"/><Button x:Name="ThemeButton" Content="Tema claro" MinHeight="32" Padding="10,5"/></StackPanel></DockPanel>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Sidebar}" Padding="10,22,10,18"><DockPanel><StackPanel DockPanel.Dock="Top"><Button x:Name="TelasNav" Content="Telas" Style="{StaticResource NavButton}"/><Button x:Name="PerfisNav" Content="Perfis" Style="{StaticResource NavButton}"/><Button x:Name="AtalhosNav" Content="Atalhos" Style="{StaticResource NavButton}"/></StackPanel><StackPanel VerticalAlignment="Bottom" Margin="10,0"><TextBlock Text="Seu espaço.&#10;Na mesma ordem." Style="{StaticResource Hint}"/><Button x:Name="DiagnosticsButton" Content="Diagnóstico" Style="{StaticResource NavButton}" Padding="0,10" Margin="0,10,0,0"/></StackPanel></DockPanel></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24,26,20">
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Monitores" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="Atualizar" Margin="0,0,8,0"/><Button x:Name="IdentifyButton" Content="Identificar telas"/></StackPanel></Grid>
    <Grid x:Name="MonitorsPage"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20,16"><StackPanel><TextBlock Text="Posições salvas" Style="{StaticResource Section}"/><Canvas x:Name="MonitorMap" Height="166" Margin="0,9,0,7" ClipToBounds="True"/><TextBlock Text="A tela desativada mantém seu lugar marcado para o retorno." Style="{StaticResource Hint}"/></StackPanel></Border>
      <Grid Margin="0,18,0,9"><TextBlock Text="Suas telas" Style="{StaticResource Section}"/><TextBlock x:Name="DeviceCount" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></Grid>
      <StackPanel x:Name="DisplayRows"/>
      <Button x:Name="RememberButton" Content="Registrar a disposição atual" HorizontalAlignment="Left" Margin="0,16,0,0"/>
     </StackPanel>
     <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="21" VerticalAlignment="Top"><StackPanel>
      <TextBlock x:Name="SelectedNumber" Text="Tela selecionada" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
      <TextBlock x:Name="SelectedName" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="SelectedModel" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
      <TextBlock x:Name="SelectedStatus" Margin="0,13,0,0" FontSize="12"/>
      <Grid Margin="0,15,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,8,15"><TextBlock Text="Resolução" Style="{StaticResource Hint}"/><TextBlock x:Name="ResolutionValue" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,0,15"><TextBlock Text="Posição salva" Style="{StaticResource Hint}"/><TextBlock x:Name="PositionValue" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,0,8,0"><TextBlock Text="Orientação" Style="{StaticResource Hint}"/><TextBlock x:Name="OrientationValue" Margin="0,3,0,0"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Desktop agora" Style="{StaticResource Hint}"/><TextBlock x:Name="CurrentPositionValue" Margin="0,3,0,0"/></StackPanel>
      </Grid>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="0,15"><StackPanel><TextBlock Text="Energia do painel" Style="{StaticResource Section}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="PowerButton" Content="Apagar" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apagar o painel selecionado"/><Button x:Name="WakeButton" Grid.Column="2" Content="Acender" AutomationProperties.Name="Acender o painel selecionado"/></Grid><TextBlock Text="Somente esta tela, mantendo a área de trabalho." Style="{StaticResource Hint}" Margin="0,9,0,0"/><TextBlock x:Name="PowerSupportLabel" Style="{StaticResource Hint}" Margin="0,8,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis"/><Button x:Name="ProbeButton" Content="Verificar compatibilidade" Margin="0,10,0,0" Padding="8,6" MinHeight="32"/></StackPanel></Border>
      <CheckBox x:Name="PreserveCheck" Content="Preservar posição ao reativar" IsChecked="True" Margin="0,15,0,0"/><TextBlock x:Name="MemoryNote" Style="{StaticResource Hint}" Margin="19,6,0,14"/>
      <Button x:Name="ToggleButton" Content="Desativar tela"/><TextBlock x:Name="ToggleNote" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
     </StackPanel></Border>
    </Grid>
    <StackPanel x:Name="ProfilesPage" Visibility="Collapsed"><TextBlock Text="Perfis salvos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><StackPanel x:Name="ProfileRows"/><TextBlock Text="Cada perfil guarda as telas ativas e as posições que serão recuperadas." Style="{StaticResource Hint}" Margin="0,15,0,0"/></StackPanel>
    <StackPanel x:Name="ShortcutsPage" Visibility="Collapsed"><TextBlock Text="Atalhos globais" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Ctrl + Alt + P    Apagar o painel selecionado" Margin="0,0,0,18"/><TextBlock Text="Ctrl + Alt + L    Acender o painel selecionado" Margin="0,0,0,18"/><TextBlock Text="Ctrl + Alt + D    Desativar ou reativar a tela selecionada" Margin="0,0,0,18"/><TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}"/></StackPanel>
    <Border x:Name="ProfileBar" Background="{DynamicResource Sidebar}" CornerRadius="8" Padding="16,13" Margin="0,23,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Perfil de telas" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="ProfilePicker" Grid.Column="1" IsEditable="True" AutomationProperties.Name="Nome do perfil"/><Button x:Name="ApplyProfileButton" Grid.Column="2" Content="Aplicar" Margin="8,0,0,0"/><Button x:Name="SaveProfileButton" Grid.Column="3" Content="Salvar perfil" Margin="8,0,0,0"/></Grid></Border>
    <TextBlock x:Name="Feedback" Style="{StaticResource Hint}" Margin="0,15,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Panel}" Padding="22,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="MemoryStatus" Text="Memória de posição ativada" Style="{StaticResource Hint}" VerticalAlignment="Center"/><Button x:Name="AboutButton" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,0" MinHeight="36" AutomationProperties.Name="Sobre o TelaSync — By Fagner Lemes"><Rectangle x:Name="AuthorSignature" Width="145" Height="35" Fill="{DynamicResource Muted}"/></Button><TextBlock x:Name="OperationStatus" Grid.Column="2" Text="Aguardando uma ação" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Hint}"/></Grid></Border>
 </Grid>
</Window>
